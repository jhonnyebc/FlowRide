# Copia este archivo a .env y define valores propios. .env NO se versiona (ADR-0014).
# Puerto del host para el contenedor (5433 evita chocar con un PostgreSQL local en 5432).
POSTGRES_PORT=5433

# Superusuario del servidor PostgreSQL local (solo administración y aprovisionamiento).
POSTGRES_USER=flowride_admin
POSTGRES_PASSWORD=cambia-esta-contrasena

# Rol del catálogo de plataforma. Las contraseñas de los Silos las genera la herramienta de
# aprovisionamiento y quedan en el almacén de secretos de cada operador, no aquí.
CATALOGO_DB_PASSWORD=cambia-esta-contrasena-catalogo

# Administrador de Keycloak de la plataforma (realm master). Solo lo usa la herramienta de aprovisionamiento.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=flowride_admin
KEYCLOAK_ADMIN_PASSWORD=cambia-esta-contrasena-keycloak

# Interfaz web de Mailpit (correos de Keycloak en local).
MAILPIT_UI_PORT=8025

# Panel de observabilidad (Aspire Dashboard): interfaz web y puerto OTLP al que la API y el borde envían logs,
# trazas y métricas al correr en local (launchSettings.json usa http://localhost:4317).
OBSERVABILIDAD_UI_PORT=18888
OTLP_PORT=4317

# WAF (ModSecurity + OWASP CRS) delante del borde: https://<operador>.dev.localhost:9443. WAF_MODO=On bloquea;
# DetectionOnly solo registra (para revisar falsos positivos). WAF_BACKEND es el borde al que reenvía.
WAF_PORT=9443
WAF_MODO=On
WAF_BACKEND=https://host.docker.internal:8443
# Certificado del WAF. Sin estas dos líneas usa uno autofirmado (el navegador advierte). Para usar el de desarrollo de
# .NET, que ya cubre *.dev.localhost: dotnet dev-certs https --trust y luego
# dotnet dev-certs https --export-path docker/waf/certificados/flowride-dev.pem --format PEM --no-password
# (esa carpeta no se versiona: lleva la clave privada), y quitar el # de estas dos líneas.
#WAF_CERTIFICADO=/etc/nginx/certificados/flowride-dev.pem
#WAF_CLAVE_CERTIFICADO=/etc/nginx/certificados/flowride-dev.key
