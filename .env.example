# Copia este archivo a .env y define valores propios. .env NO se versiona (ADR-0014).
# Puerto del host para el contenedor (5433 evita chocar con un PostgreSQL local en 5432).
POSTGRES_PORT=5433

# Superusuario del servidor PostgreSQL local (solo administración y aprovisionamiento).
POSTGRES_USER=flowride_admin
POSTGRES_PASSWORD=cambia-esta-contrasena

# Rol del catálogo de plataforma. Las contraseñas de los Silos las genera la herramienta de
# aprovisionamiento y quedan en el almacén de secretos de cada operador, no aquí.
CATALOGO_DB_PASSWORD=cambia-esta-contrasena-catalogo
