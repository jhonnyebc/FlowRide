{
  "name": "flowride-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Panel Web de FlowRide (ADR-0019): SPA en React + TypeScript para el Administrador y el Operador logístico.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
