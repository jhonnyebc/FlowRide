-27" target="1Clase-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1Clase-112" value="0..*" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="1Clase-111"><mxGeometry x="-0.82" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="1Clase-113" value="1" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="1Clase-111"><mxGeometry x="0.82" relative="1" as="geometry"><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="1Clase-114" value="&lt;b&gt;Convenciones&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1661" width="200" height="20" as="geometry"/></mxCell><mxCell id="1Clase-115" value="" style="rounded=0;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="40" y="1685" width="26" height="16" as="geometry"/></mxCell><mxCell id="1Clase-116" value="Núcleo RF-10 (asignación automática)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1683" width="330" height="20" as="geometry"/></mxCell><mxCell id="1Clase-117" value="" style="rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="1707" width="26" height="16" as="geometry"/></mxCell><mxCell id="1Clase-118" value="Dominio operativo" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1705" width="330" height="20" as="geometry"/></mxCell><mxCell id="1Clase-119" value="" style="rounded=0;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="1729" width="26" height="16" as="geometry"/></mxCell><mxCell id="1Clase-120" value="Capacidades V1: calificación y telemetría (RF-54/55/56)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1727" width="330" height="20" as="geometry"/></mxCell><mxCell id="1Clase-121" value="" style="rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1751" width="26" height="16" as="geometry"/></mxCell><mxCell id="1Clase-122" value="Value object" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1749" width="330" height="20" as="geometry"/></mxCell><mxCell id="1Clase-123" value="" style="rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="1773" width="26" height="16" as="geometry"/></mxCell><mxCell id="1Clase-124" value="Enumeración" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1771" width="330" height="20" as="geometry"/></mxCell><mxCell id="1Clase-125" value="&lt;b&gt;Notas de diseño&lt;/b&gt;&lt;br/&gt;• Las relaciones entre clases se expresan como asociaciones; las llaves foráneas solo aparecen en el modelo entidad-relación (página 3).&lt;br/&gt;• Las referencias al actor de una acción (Actor, CanceladaPor, ReportadoPor: Usuario) se muestran en notación de atributo para no saturar el diagrama.&lt;br/&gt;• Asignacion.DecisionId referencia por identidad al decision log del motor (FlowRide.Application, página 2): los módulos no comparten objetos.&lt;br/&gt;• La &lt;b&gt;disponibilidad&lt;/b&gt; del conductor no se persiste como estado: se deriva de sus turnos y asignaciones vigentes, lo que hace reproducible la decisión.&lt;br/&gt;• &lt;b&gt;Version&lt;/b&gt; es el token de concurrencia optimista (ADR-0007). Una solicitud tiene a lo sumo una asignación vigente.&lt;br/&gt;• EmpresaCliente es el cliente empresarial atendido (aerolínea, minera…), no el tenant: el aislamiento entre operadores lo da el modelo Silo.&lt;br/&gt;• SolicitudViaje reemplaza a SolicitudTransporte. Evolución declarada del modelo (contexto v10, Capa 4): Calificacion, CancelacionSolicitud, EstadoSolicitudHistorial, EsPersonal, RegistroUbicacion.&lt;br/&gt;• La telemetría (RegistroUbicacion, DesviacionEta) sirve para monitoreo y ETA; &lt;b&gt;no&lt;/b&gt; participa en la asignación (ADR-0005, ADR-0009)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFDE7;strokeColor=#BDB76B;" vertex="1" parent="1"><mxGeometry x="470" y="1661" width="1180" height="200" as="geometry"/></mxCell><mxCell id="1Clase-126" value="&lt;b&gt;Notación&lt;/b&gt;&lt;br/&gt;◆ composición: la parte no existe sin el todo.&lt;br/&gt;△ generalización (herencia).&lt;br/&gt;→ asociación navegable, con multiplicidad en cada extremo.&lt;br/&gt;⇢ dependencia (línea punteada): uso de un tipo enumerado o value object como atributo, parámetro o retorno.&lt;br/&gt;{máx. 1 vigente}: restricción de la asociación (ver índice único parcial en la página 3)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#F7F9FC;strokeColor=#9AA9C0;" vertex="1" parent="1"><mxGeometry x="1680" y="1661" width="520" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2ClasesMotordeasignacin" name="2. Clases - Motor de asignación"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2Clase-122" value="Reglas de desempate" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;dashed=1;fillColor=#FFF5E6;strokeColor=#999999;opacity=60;" vertex="1" parent="1"><mxGeometry x="2241" y="1104" width="264" height="262" as="geometry"/></mxCell><mxCell id="2Clase-115" value="Reglas de puntuación" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontS