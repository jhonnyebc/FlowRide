Size=10;endSize=10;" edge="1" parent="1" source="3Entid-29" target="3Entid-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3Entid-65" value="&lt;b&gt;Esquemas&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1246" width="200" height="20" as="geometry"/></mxCell><mxCell id="3Entid-66" value="" style="rounded=0;fillColor=#3B6EA8;strokeColor=#3B6EA8;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="26" height="14" as="geometry"/></mxCell><mxCell id="3Entid-67" value="ops — operación (RF-03..RF-34, RF-54)" style="text;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1267" width="400" height="20" as="geometry"/></mxCell><mxCell id="3Entid-68" value="" style="rounded=0;fillColor=#C77700;strokeColor=#C77700;" vertex="1" parent="1"><mxGeometry x="40" y="1291" width="26" height="14" as="geometry"/></mxCell><mxCell id="3Entid-69" value="motor — configuración y decision log del motor (RF-10/11/21)" style="text;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1288" width="400" height="20" as="geometry"/></mxCell><mxCell id="3Entid-70" value="" style="rounded=0;fillColor=#4E8A3E;strokeColor=#4E8A3E;" vertex="1" parent="1"><mxGeometry x="40" y="1312" width="26" height="14" as="geometry"/></mxCell><mxCell id="3Entid-71" value="telemetria — GPS y desviación de ETA (RF-55/56)" style="text;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1309" width="400" height="20" as="geometry"/></mxCell><mxCell id="3Entid-72" value="" style="rounded=0;fillColor=#7A5C99;strokeColor=#7A5C99;" vertex="1" parent="1"><mxGeometry x="40" y="1333" width="26" height="14" as="geometry"/></mxCell><mxCell id="3Entid-73" value="notif — outbox, notificaciones y WhatsApp" style="text;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1330" width="400" height="20" as="geometry"/></mxCell><mxCell id="3Entid-74" value="" style="rounded=0;fillColor=#555555;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1354" width="26" height="14" as="geometry"/></mxCell><mxCell id="3Entid-75" value="audit — auditoría legal (ADR-0011)" style="text;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1351" width="400" height="20" as="geometry"/></mxCell><mxCell id="3Entid-76" value="" style="rounded=0;fillColor=#A33A3A;strokeColor=#A33A3A;" vertex="1" parent="1"><mxGeometry x="40" y="1375" width="26" height="14" as="geometry"/></mxCell><mxCell id="3Entid-77" value="plataforma — registro de tenants (BD aparte)" style="text;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1372" width="400" height="20" as="geometry"/></mxCell><mxCell id="3Entid-78" value="&lt;b&gt;Convenciones del modelo físico&lt;/b&gt;&lt;br/&gt;• PK uuid generadas por la aplicación; fechas en &lt;b&gt;timestamptz&lt;/b&gt; (UTC). Enums persistidos como texto (varchar) para legibilidad y auditoría.&lt;br/&gt;• &lt;b&gt;xmin&lt;/b&gt; = token de concurrencia optimista de PostgreSQL mapeado por EF Core/Npgsql (ADR-0007).&lt;br/&gt;• Unicidad e integridad en BD: índices únicos parciales y &lt;b&gt;EXCLUDE USING gist&lt;/b&gt; (requiere la extensión btree_gist) impiden la doble asignación de un conductor o vehículo en franjas solapadas.&lt;br/&gt;• Silo: cada operador tiene su propia BD con este esquema completo. &lt;b&gt;empresa_cliente_id&lt;/b&gt; identifica al cliente empresarial atendido (aerolínea, minera…), nunca al tenant.&lt;br/&gt;• Herencia de usuario como tablas por tipo (TPT): ops.pasajero y ops.conductor comparten PK con ops.usuario.&lt;br/&gt;• Las FK de actor (actor_id, cancelada_por_id, reportado_por_id, creada_por_id, modificado_por_id, destinatario_id), conversacion_whatsapp.usuario_id y las del decision log hacia conductor/vehículo apuntan a ops.usuario / ops.vehiculo. No se dibujan para mantener la legibilidad.&lt;br/&gt;• calificacion.pasajero_id / conductor_id y registro_ubicacion.conductor_id se guardan desnormalizados para reportes y consultas por conductor (en el diagrama de clases se obtienen navegando Viaje → Asignacion).&lt;br/&gt;• motor.decision_asignacion, evaluacion_candidato y resultado_regla persisten AssignmentDecisionLog, CandidateEvaluation y RuleOutcome (página 2).&lt;br/&gt;• Sin credenciales: la identidad la gestiona el proveedor OIDC (ADR-0003); ops.usuario solo guarda identidad_externa_id." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFDE7;strokeColor=#BDB76B;" vertex="1" parent="1"><mxGeometry x="520" y="1246" width="1000" height="235" as="geometry"/></mxCell><mxCell id="3Entid-79" value="&lt;b&gt;Alcance de la implementación actual (RF-10)&lt;/b&gt;&lt;br/&gt;Se implementa: rol, usuario, pasajero, conductor, empresa_cliente, itinerario, turno, vehiculo, solicitud_viaje, estado_solicitud_historial, asignacion, esquema motor completo.&lt;br/&gt;&lt;br/&gt;Modelado pero &lt;b&gt;pendiente hasta que se pida&lt;/b&gt;: notif.* (Outbox, WhatsApp), telemetria.*, audit.*, plataforma.* (Keycloak / Key Vault), calificación, viajes, paradas e incidentes." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF3E0;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1550" y="1246" width="700" height="235" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>