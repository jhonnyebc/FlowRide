dArrow=block;endFill=0;endSize=14;" edge="1" parent="1" source="2Clase-111" target="2Clase-89"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2036.5" y="1085"/><mxPoint x="1351.6" y="1085"/></Array></mxGeometry></mxCell><mxCell id="2Clase-120" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/i&gt;&lt;br/&gt;&lt;b&gt;ITieBreakRule&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ Compare(a: CandidateEvaluation,&lt;br/&gt;      b: CandidateEvaluation): int&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="2255" y="1140" width="230" height="82" as="geometry"/></mxCell><mxCell id="2Clase-121" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;StableTieBreaker&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;1. menos asignaciones recientes&lt;br/&gt;2. mayor tiempo desde la última&lt;br/&gt;3. ConductorId (orden estable)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="2279" y="1272" width="212" height="82" as="geometry"/></mxCell><mxCell id="2Clase-123" value="" style="html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0435;entryY=1;entryDx=0;entryDy=0;endArrow=block;endFill=0;endSize=14;dashed=1;" edge="1" parent="1" source="2Clase-121" target="2Clase-120"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2265" y="1313"/></Array></mxGeometry></mxCell><mxCell id="2Clase-124" value="" style="html=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=block;endFill=0;endSize=14;" edge="1" parent="1" source="2Clase-120" target="2Clase-89"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2370" y="1085"/><mxPoint x="1351.6" y="1085"/></Array></mxGeometry></mxCell><mxCell id="2Clase-125" value="&lt;b&gt;Convenciones&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1620" width="200" height="20" as="geometry"/></mxCell><mxCell id="2Clase-126" value="" style="rounded=0;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="40" y="1644" width="26" height="16" as="geometry"/></mxCell><mxCell id="2Clase-127" value="Motor de asignación (RF-10)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1642" width="330" height="20" as="geometry"/></mxCell><mxCell id="2Clase-128" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="40" y="1666" width="26" height="16" as="geometry"/></mxCell><mxCell id="2Clase-129" value="Interfaz (contrato)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1664" width="330" height="20" as="geometry"/></mxCell><mxCell id="2Clase-130" value="" style="rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="1688" width="26" height="16" as="geometry"/></mxCell><mxCell id="2Clase-131" value="Record inmutable de entrada/salida" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1686" width="330" height="20" as="geometry"/></mxCell><mxCell id="2Clase-132" value="" style="rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="1710" width="26" height="16" as="geometry"/></mxCell><mxCell id="2Clase-133" value="Enumeración" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1708" width="330" height="20" as="geometry"/></mxCell><mxCell id="2Clase-134" value="" style="rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="1732" width="26" height="16" as="geometry"/></mxCell><mxCell id="2Clase-135" value="Clase del dominio (página 1)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1730" width="330" height="20" as="geometry"/></mxCell><mxCell id="2Clase-136" value="" style="rounded=0;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="1754" width="26" height="16" as="geometry"/></mxCell><mxCell id="2Clase-137" value="Implementación en Infrastructure" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="74" y="1752" width="330" height="20" as="geometry"/></mxCell><mxCell id="2Clase-138" value="&lt;b&gt;Flujo determinista de AssignmentEngine.Decide(ctx)&lt;/b&gt;&lt;br/&gt;1. Candidatos ordenados por ConductorId (ninguna consulta sin ORDER BY).&lt;br/&gt;2. ConfigurationValidator valida la configuración; si es inválida no se asigna.&lt;br/&gt;3. Reglas &lt;b&gt;eliminatorias&lt;/b&gt; por Order: los descartados quedan en el log con su motivo.&lt;br/&gt;4. Reglas de &lt;b&gt;prioridad&lt;/b&gt;: nivel de prioridad de cada candidato.&lt;br/&gt;5. Reglas de &lt;b&gt;puntuación&lt;/b&gt;: valor 0..100 × Weight; TotalScore = Σ.&lt;br/&gt;6. Ranking: Priority desc, TotalScore desc.&lt;br/&gt;7. &lt;b&gt;Desempate&lt;/b&gt; estable (StableTieBreaker), nunca aleatorio.&lt;br/&gt;8. AssignmentResult + AssignmentDecisionLog: candidatos, resultado de cada regla, puntajes, desempate y versión de configuración.&lt;br/&gt;Misma entrada + misma configuración ⇒ mismo resultado. El tiempo llega por IClock, nunca DateTime.Now." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFDE7;strokeColor=#BDB76B;" vertex="1" parent="1"><mxGeometry x="460" y="1620" width="760" height="215" as="geometry"/></mxCell><mxCell id="2Clase-139" value="&lt;b&gt;Persistencia y consistencia (ADR-0007)&lt;/b&gt;&lt;br/&gt;• El caso de uso guarda Asignacion, el cambio de estado de SolicitudViaje y el AssignmentDecisionLog en &lt;b&gt;una sola transacción&lt;/b&gt; (IUnitOfWork).&lt;br/&gt;• Concurrencia optimista con token de versión en SolicitudViaje, Asignacion, Turno y Vehiculo.&lt;br/&gt;• La base de datos impide dos asignaciones vigentes por solicitud y franjas solapadas por conductor o vehículo (página 3).&lt;br/&gt;• Ante un conflicto se recargan los candidatos y se reintenta la decisión un número acotado de veces; sin candidatos ⇒ SolicitudViaje.SinCandidatos y alerta al Operador logístico (RF-13).&lt;br/&gt;• Las reglas no se conocen entre sí; solo el motor las orquesta. Una regla nueva = una clase nueva registrada en el catálogo (inyección de dependencias)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFDE7;strokeColor=#BDB76B;" vertex="1" parent="1"><mxGeometry x="1250" y="1620" width="760" height="215" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3EntidadRelacin" name="3. Entidad-Relación"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3Entid-1" value="&lt;b&gt;FlowRide — Modelo entidad-relación&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=22;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2200" height="34" as="geometry"/></mxCell><mxCell id="3Entid-2" value="&lt;span style=&quot;color:#555&quot;&gt;PostgreSQL 17 · una base de datos por operador (Silo) · esquemas ops, motor, telemetria, notif y audit · Ingeniería del Software 2 (ISS0666) · Universidad Católica de Oriente · v1.0 · octubre 2026&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="2200" height="22" as="geometry"/></mxCell><mxCell id="3Entid-3" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot; style=&quot;background:#3B6EA8;color:#fff;font-weight:bold;padding:3px 4px;text-align:center;&quot;&gt;ops.rol&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;width:34px;color:#555;font-size:10px;&quot;&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:0 4px;&quot;&gt;&lt;u&gt;id&lt;/u&gt;&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#777;text-align:right;&quot;&gt;uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;width:34px;color:#555;font-size:10px;&quot;&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:0 4px;&quot;&gt;nombre&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#777;text-align:right;&quot;&gt;varchar(50)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:0 4px;width:34px;color:#555;font-size:10px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:0 4px;&quot;&gt;descripcion&lt;/td&gt;&lt;td style=&quot;padding:0 4px;color:#777;text-align:right;&quot;&gt;varchar(200)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;overflow=fill;whiteSpace=wrap;verticalAlign=top;align=left;fillColor=#FFFFFF;strokeColor=#3B6EA8;strokeWidth=1.5;spacing=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="230" height="69" as="geometry"/></mxCell><mxCell id="3Entid-4" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot; style=&quot;background:#3B6EA8;color:#fff;font-weight:bold;p